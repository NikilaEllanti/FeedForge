{
  "manifest_version": 3,
  "name": "FeedForge",
  "short_name": "FeedForge",
  "version": "1.0.0",
  "description": "Local-first AI that personalizes your social feeds based on your own goals — not platform engagement algorithms.",
  "author": "FeedForge Team",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.reddit.com/*",
    "https://www.linkedin.com/*",
    "https://www.youtube.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.reddit.com/*",
        "https://www.linkedin.com/*",
        "https://www.youtube.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "FeedForge",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },

  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["*.wasm", "*.onnx", "models/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
